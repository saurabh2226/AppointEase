# ─── App ───────────────────────────────────────────────
APP_NAME=AppointEase
APP_VERSION=1.0.0
DEBUG=true

# ─── Database ──────────────────────────────────────────
# Local development
DATABASE_URL=postgresql+asyncpg://appointease:appointease123@localhost:5432/appointease_local
# AWS RDS (dev/prod) — filled by Terraform
# DATABASE_URL=postgresql+asyncpg://dbadmin:PASSWORD@RDS_ENDPOINT:5432/appointease_dev

# ─── Redis ─────────────────────────────────────────────
# Local development
REDIS_URL=redis://localhost:6379/0
# AWS ElastiCache (dev/prod) — filled by Terraform
# REDIS_URL=redis://ELASTICACHE_ENDPOINT:6379/0

# ─── JWT ───────────────────────────────────────────────
SECRET_KEY=your-super-secret-key-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── CORS ──────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# ─── SMTP / Email ──────────────────────────────────────
# Get Gmail App Password from: myaccount.google.com → Security → App Passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-16-char-app-password
EMAIL_FROM=AppointEase <no-reply@appointease.local>

# ─── Razorpay ──────────────────────────────────────────
# Get from: dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ─── Google OAuth ──────────────────────────────────────
# Get from: console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-secret

# ─── Rate Limiting ─────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_AUTH_PER_MINUTE=10
